#!/sbin/openrc-run
# BẢN CẤU HÌNH CHƯA AN TOÀN: chỉ để đối chiếu ở Phần D, KHÔNG cài đặt.

name="demoapp"
command="/srv/demoapp/venv/bin/gunicorn"
command_args="--workers 2 --bind 0.0.0.0:8000 app:app"
directory="/srv/demoapp/app"
command_background="yes"
pidfile="/run/demoapp.pid"
export DEMOAPP_SECRET_KEY="dev"

depend() {
	need net
}
