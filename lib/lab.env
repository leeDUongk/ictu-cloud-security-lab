# shellcheck shell=bash
# =====================================================================
# lib/lab.env — MỘT NGUỒN DUY NHẤT cho mật khẩu, IP, tên tài nguyên lab.
# Các script chỉ cần: source lib/common.sh (common.sh sẽ nạp file này).
#
# CẢNH BÁO: CHỈ DÙNG TRONG LAB. Mật khẩu ở đây được công khai trong repo,
# dành cho môi trường cá nhân, cô lập. KHÔNG dùng lại ở bất kỳ nơi nào khác.
# =====================================================================

# --- Phiên bản / môi trường ------------------------------------------
ONE_VERSION=6.10.3                 # ghim miniONE, KHÔNG dùng latest (7.x đổi Sunstone, cần 32 GiB RAM)
HOST_IP=192.168.50.1               # Windows host (Hyper-V NAT gateway)
VM_LAB_IP=192.168.50.10            # VM ONE-Lab (Front-end + KVM)

# --- Mật khẩu lab (công khai) ----------------------------------------
ONEADMIN_PASSWORD='OneLab@2026'    # oneadmin (miniONE)
GUEST_ROOT_PASSWORD='Lab@123'      # root của VM khách (CONTEXT PASSWORD)
ALICE_PASSWORD='Alice@123'         # Bài 4
BOB_PASSWORD='Bob@123'             # Bài 4
AUDITOR_PASSWORD='Audit@123'       # Bài 4
MYSQL_ROOT_PASSWORD_WEAK='123456'            # Bài 9 setup (cố ý yếu)
MYSQL_ROOT_PASSWORD_STRONG='Db@Strong2026'   # Bài 9 sau khi respond
NGINX_BASIC_USER=labadmin          # Bài 6
NGINX_BASIC_PASSWORD='Labadmin@123'

# --- Mạng VM lồng (miniONE tạo bridge minionebr) ----------------------
LAB_BRIDGE=minionebr
LAB_NET=lab-net
LAB_NETWORK=172.16.100.0
LAB_NETMASK=255.255.255.0
LAB_GATEWAY=172.16.100.1
LAB_DNS=8.8.8.8
LAB_AR_START=172.16.100.200        # dải 200–249, tránh dải mặc định của miniONE (172.16.100.2+)
LAB_AR_SIZE=50

# --- IP cố định cho VM lồng -------------------------------------------
IP_CIRROS_01=172.16.100.201        # Bài 3
IP_WEB_PAAS=172.16.100.205         # Bài 5
IP_LAMP_01=172.16.100.207          # Bài 7
IP_VM_WS=172.16.100.211            # Bài 9
IP_VM_DB=172.16.100.212            # Bài 9
IP_VM_ATK=172.16.100.213           # Bài 9

# --- Image / template ---------------------------------------------------
UBUNTU_IMG=ubuntu2204-lab
CIRROS_URL=https://download.cirros-cloud.net/0.6.2/cirros-0.6.2-x86_64-disk.img
CIRROS_DIR=/var/tmp                # đường dẫn datastore cho phép (SAFE_DIRS), KHÔNG dùng /home
CIRROS_FILE=cirros-0.6.2-x86_64-disk.img
CIRROS_IMG=cirros-0.6.2
CIRROS_TMPL=cirros-tmpl
CIRROS_VM=cirros-01
CIRROS_DEV_TMPL=cirros-dev-tmpl    # Bài 4: template không gán IP cố định để nhiều user dùng chung
LAB_DS=lab-ds                      # Bài 3: datastore phụ minh hoạ
